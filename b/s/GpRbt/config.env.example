# Copy to a machine-local file and pass --config.
# Paths differ across servers; CLEAN_ROOT in particular will change.

# --- code roots ---
ITVLAGP_ROOT=/home/a26113/SRC/itvlaGp
GEOPREDICT_ROOT=/home/a26113/SRC/GeoPredict
ROBOTWIN_ROOT=/path/to/RoboTwin

# --- data ---
# RoboTwin 2.0 原数据: 每个子文件夹一个源任务 (LeRobot v2.1).
# 本机当前路径如下, 换机器时只改这一行 (或 export CLEAN_ROOT=...):
CLEAN_ROOT=/home/a26113/Dta/RoboTwin-Clean
# Optional: keep SAPIEN / inject / v3.0 products off the source tree
# KPTSIM_ROOT=/path/to/kptsim_store
# LRB_ROOT=/path/to/lrb_store
# V30_ROOT=/path/to/v30_store

# --- checkpoints / logs (must not collide across tasks) ---
CKPT_ROOT="${HOME}/Ckp/itvlaGp"

# --- python ---
VENV_ROOT=/tmp/itnvla15rbt20
TRAIN_PYTHON="${VENV_ROOT}/bin/python"
EXTRACT_PYTHON=/path/to/robotwin/conda/bin/python

# --- weights ---
HF_HOME="${VENV_ROOT}/var/hf_home"
PRETRAINED_PATH="${HF_HOME}/ckpts/InternVLA-A1.5-base"
GEOPREDICT_CKPT="${HF_HOME}/ckpts/GeoPredict_robocasa.pth"
WAN_DIR="${HF_HOME}/hub/Wan2.2-TI2V-5B"
URDF_PATH="${ROBOTWIN_ROOT}/assets/embodiments/aloha-agilex/urdf/arx5_description_isaac.urdf"

# --- training ---
PROC_PER_NODE=8
BATCH_SIZE=16
NODE_COUNT=1
WARMUP_STEPS=400
# SFT 总 epoch（有效 epoch 数）。各任务的 optimizer steps 与 checkpoint 保存点
# 由 compute_sft_steps.py 按该任务的 total_frames 与此值自动计算。
SFT_EPOCHS=76
SFT_EFFECTIVE_BATCH_TARGET=128
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
WARMUP_MASTER_PORT=36201
SFT_MASTER_PORT=36202
